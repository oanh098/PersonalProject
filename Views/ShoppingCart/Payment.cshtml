@{
}
<img id="qr-code" src="@ViewBag.QrUrl" alt="Payment QR" />

<input type="hidden" id="order-id" value="@ViewBag.OrderId" />

<p id="status-message">Please scan to pay...</p>

<script>
    const API_BASE_URL = window.location.origin.includes('localhost') 
    ? 'http://localhost:5223' 
    : 'https://personalproject-a5zz.onrender.com';
    const orderId = document.getElementById('order-id').value;
    const statusMsg = document.getElementById('status-message');

    // 1. Polling: Ask server every 3 seconds if paid
    const checkInterval = setInterval(async () => {
        try {
            const response = await fetch(`${API_BASE_URL}/api/payment/check-status/${orderId}`);
            const result = await response.text(); // Assuming endpoint returns "PAID" or "PENDING"

            if (result === "PAID") {
                clearInterval(checkInterval);
                statusMsg.innerText = "Payment Received! Redirecting...";
                // Redirect user to success page
                window.location.href = `/ShoppingCart/OrderSuccess?orderId=${orderId}`;
            }
        } catch (err) {
            console.error("Polling error:", err);
        }
    }, 3000);

    // 2. Add an animation to the QR image
    document.getElementById('qr-code').addEventListener('click', () => {
        alert("If the code is blurry, try refreshing the page!");
    });
</script>